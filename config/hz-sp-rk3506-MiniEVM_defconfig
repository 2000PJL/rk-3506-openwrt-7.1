#
# HZ-RK3506SP MiniEVM (RK3506, 32-bit ARM Cortex-A7) Configuration
# 基于 lubancat_defconfig 改造，target 改为 rk3506 子目标
#
# 本轮裁剪为"纯路由 + LuCI 管理界面"：去掉代理/VPN、文件/媒体服务、
# collectd 监控、python3/ruby/boost 运行时和本板用不到的 WiFi 驱动。
# 只列顶层包，依赖交给 kconfig 解析，不再手工枚举 lib*。
#
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_rk3506=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_rk3506_DEVICE_hzhy_mini_evm_nand=y
CONFIG_TARGET_DEVICE_rockchip_rk3506_DEVICE_hzhy_mini_evm_nand256=y
CONFIG_TARGET_DEVICE_rockchip_rk3506_DEVICE_hzhy_mini_evm_sd=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_UBIFS=y

CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FDISK=y
CONFIG_BUSYBOX_CONFIG_LSPCI=y
CONFIG_BUSYBOX_CONFIG_LSUSB=y
CONFIG_BUSYBOX_CONFIG_MKE2FS=y
CONFIG_BUSYBOX_CONFIG_MKFS_EXT2=y
CONFIG_BUSYBOX_CONFIG_MKFS_MINIX=y


#
# DNS / DHCP：dnsmasq-full 提供 DHCPv6、DNSSEC、nftset 联动
#
# dnsmasq 必须显式 =n，不能写成 =m。include/target.mk 的 DEFAULT_PACKAGES.router
# 会把它默认成 =y，而 dnsmasq-full 只声明 PROVIDES:=dnsmasq、没有 CONFLICTS，
# kconfig 不会阻止两者同时进入 rootfs，它们会在 make package/install 时抢
# /etc/dnsmasq.conf、/etc/init.d/dnsmasq 等文件。更隐蔽的是 =m 在 make 的
# $(if $(CONFIG_PACKAGE_dnsmasq),...) 里仍为真，tmp/.packagedeps 会保留
# nodhcpv6 变体，PACKAGE_INSTALL_FILES 因此引用
# staging_dir/target-*/pkginfo/dnsmasq.nodhcpv6.install；热缓存里残留的这份
# 旧 stamp 会被 cat 进 opkg 安装列表，把 dnsmasq 重新装回来。=n 会让该变体
# 彻底消失，旧缓存也就无从注入。
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

#
# 路由 / 排查工具
#
