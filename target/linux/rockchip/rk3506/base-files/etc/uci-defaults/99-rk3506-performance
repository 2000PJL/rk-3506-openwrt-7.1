#!/bin/sh
# Ship software flow offloading enabled.  The guard keeps an explicit user
# choice (including "off") across reflashes and sysupgrades.
[ -f /etc/config/firewall ] || exit 0

if ! uci -q get firewall.@defaults[0].flow_offloading >/dev/null 2>&1; then
	echo "Enabling software flow offloading (fw4)" >&2
	uci set firewall.@defaults[0].flow_offloading=1
	uci commit firewall
fi

exit 0
