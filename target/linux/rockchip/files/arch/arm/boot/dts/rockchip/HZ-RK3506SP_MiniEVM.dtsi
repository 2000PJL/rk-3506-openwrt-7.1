/*
 * Copyright (c) 2025 HZHY Electronics Co., Ltd.
 *
 * HZ-RK3506SP MiniEVM common device tree include.
 * Ported from HZHY kernel-6.1 SDK to mainline Linux 7.1 / OpenWrt.
 */

#include "rk3506.dtsi"

/ {
	model = "HZ-RK3506SP_MiniEVM";
	compatible = "rockchip,rk3506-evb1-v10", "rockchip,rk3506";

	/* PSCI is provided by the Rockchip OP-TEE secure monitor.
	 * Linux brings up secondary CPUs via PSCI SMC calls. */

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		i2c0 = &i2c0;
		i2c2 = &i2c2;
	};

	chosen {
		stdout-path = &uart0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* OP-TEE / trust resident memory.
		 * The SPL/loader pins OP-TEE in low DRAM [0x0, ~0x62000).
		 * Without this carve-out the kernel adds those pages to the
		 * free pool and hands them to user space; the secure world
		 * then rejects the access as a precise external abort.
		 * Mirrors the vendor rk3506 DT's trust@0 reservation. */
		trust@0 {
			/* OP-TEE reports 0x62000 bytes, but the secure DRAM firewall
			 * protects low memory at 4 MiB granularity on this board.
			 * Reserve 4 MiB to avoid handing secure pages to userspace. */
			reg = <0x0 0x400000>;
		};
	};

	vcc12v_dc: vcc12v-dc {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dc";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dc>;
	};

	vcc3v3_stb: vcc3v3-stb {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_stb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_stb>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vccio_sd: vccio-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vccio_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc5v0_otg0: vcc5v0-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg0_en>;
	};

	vcc5v0_otg1: vcc5v0-otg1-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg1";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg1_en>;
	};

	leds: leds {
		compatible = "gpio-leds";
		status = "okay";
		run_led: run-led {
			label = "run";
			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

};

/* CPU operating points (OPP).
 * Without an OPP table the cpufreq-dt driver has no valid frequency
 * targets; ondemand may attempt to scale the PVTPLL to an undefined
 * rate and hang the system.  These are conservative, clk-only points.
 * If a PMIC-based cpu-supply is added later, append voltage columns. */
&cpu0 {
	operating-points = <
		1200000	0	/* 1.2 GHz (stock boot speed) */
		1008000	0	/* 1.008 GHz */
		816000	0	/* 816 MHz */
		600000	0	/* 600 MHz */
		408000	0	/* 408 MHz */
	>;
};

&cpu1 {
	/* PSCI brings up cpu1 */
};

&cpu2 {
	/* PSCI brings up cpu2 */
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&uart3 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_i2c2_scl &rm_io5_i2c2_sda>;

	lt8912b: lt8912b@48 {
		compatible = "lontium,lt8912b-hdmi";
		reg = <0x48>;
		reset-gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&sai1 {
	status = "disabled";
};

&spi0 {
	status = "disabled";
	num-cs = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io14_spi0_clk &rm_io13_spi0_csn0 &rm_io15_spi0_csn1 &rm_io17_spi0_mosi &rm_io16_spi0_miso>;
	flash@0 {
		compatible = "winbond,w25q20cl", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
	flash@1 {
		compatible = "winbond,w25q20cl", "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <50000000>;
	};
};

&sfc {
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&u2phy_otg0 {
	status = "okay";
};

&u2phy_otg1 {
	status = "okay";
	/* Consumed by the generic PHY core (phy-core.c), which enables it as
	 * soon as the PHY is powered on.
	 */
	phy-supply = <&vcc5v0_otg1>;
};

&usb20_otg0 {
	status = "okay";
	dr_mode = "host";
	/* Sheet 06: GPIO PA2 switches U5, the load switch feeding the Type-C
	 * VBUS pin. dwc2 reads vbus-supply from the controller node and enables
	 * it while the root hub is up, which is the only thing that turns the
	 * rail on: vcc5v0_otg0 has no regulator-boot-on/always-on, so without
	 * this the port never gets 5 V. The vendor kernel did the same job from
	 * phy-rockchip-inno-usb2.c, but mainline 7.1 has no regulator support
	 * in that driver, so a vbus-supply on &u2phy_otg0 would be a no-op.
	 */
	vbus-supply = <&vcc5v0_otg0>;
};

&usb20_otg1 {
	status = "okay";
	dr_mode = "host";
	/* vcc5v0_otg1 is regulator-always-on, so this only takes a reference;
	 * regulator_disable() on an always-on rail is a no-op.
	 */
	vbus-supply = <&vcc5v0_otg1>;
};

/* Sheet 03: YT8512H on the rmii0 pin group (GPIO2 bank). The 50 MHz RMII clock
 * arrives on RMII0_CLK, hence clock_in_out "input".
 *
 * No clock pad here on purpose: the vendor board DTS
 * (kernel-6.1 HZ-RK3506SP_MiniEVM.dtsi:162-181) gives each MAC exactly four
 * pinctrl groups, never eth_clk0/1_25m_out_pins, and overrides neither clocks
 * nor assigned-clock-rates, so CLK_MAC_OUT stays unused and GPIO0_C4/C3 are not
 * muxed to a 25 MHz output. The factory NAND image boots with those pads at
 * func 0 and both ports at 100M, and tri-stating the pad on our image changed
 * nothing, so the SoC is not this PHY's timebase and driving it only risks
 * contending with the crystal on the XI pin.
 *
 * Reset: RMII0_RSTN leaves ball L1 (GPIO0_C2) and reaches PHYRSTB through a
 * fitted R21 0R -- straight connection to an RSTN-named pin, so ACTIVE_LOW. An
 * undriven pad left the reset input floating, which is what produced
 * "MDIO device at address 3 is missing".
 *
 * MDIO address 0: measured on hardware as stmmac-0:00 (address 3 also answers,
 * which is why the earlier strap-based guess looked plausible). */
&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "input";

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
	&eth_rmii0_tx_bus2_pins
	&eth_rmii0_rx_bus2_pins
	&eth_rmii0_clk_pins>;

	phy-handle = <&rmii_phy0>;

	/* Vendor text. stmmac_mdio.c:398-411 uses slot 0 as the wait *before*
	 * asserting reset -- the "power stable -> assert" margin the vendor wiki
	 * asks to keep above 10 ms -- then holds the pulse for slot 1 and waits
	 * slot 2 after release; the earlier <0 20000 100000> skipped slot 0, which
	 * only a cold boot could hide. snps,reset-active-low is read by no kernel,
	 * so polarity still comes only from the GPIO flag. */
	snps,reset-gpio = <&gpio0 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <20000 20000 20000>;

	status = "okay";
};

&mdio0 {
	/* rk3506.dtsi carries this compatible and patches-7.1/0021 deletes it; it
	 * has to come back to reach the vendor shape, because without it
	 * stmmac_of_get_mdio() returns NULL, no bus is registered and phy-handle has
	 * nothing to resolve against (-ENODEV). Verified on hardware at c709067:
	 * both mdio_bus stmmac-0 and stmmac-1 appear, no -EBUSY. */
	compatible = "snps,dwmac-mdio";

	rmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
};

/* Sheet 04: U3, a YT8522H on the rmii1 pin group (GPIO3 bank), with its own
 * 25 MHz crystal -- Y2 and load caps C24/C25 are fitted, confirmed visually on
 * the board, which overturns the "crystal-less, Y2/C24/C25 = NC" reading this
 * file used to carry. So the reference for this MAC is the PHY's, not ours, and
 * GPIO0_C3 must not be muxed to eth_clk1_25m_out (see gmac0 above).
 *
 * Reset: RMII1_RSTN/1.8V leaves ball G1 (GPIO0_D0). The series R51 to PHY1RSTB
 * is NC; the net instead goes through R62 330R into the base of Q1 (MMBT3904,
 * emitter to ground), whose open collector pulls PHY1RSTB low through D2 while
 * R63 4.7K holds it high when Q1 is off. That is an inverting stage, so
 * asserting reset drives the pad HIGH -- GPIO_ACTIVE_HIGH despite the RSTN name.
 *
 * MDIO address 0: measured on hardware as stmmac-1:00. */
&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "input";

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins
	&eth_rmii1_tx_bus2_pins
	&eth_rmii1_rx_bus2_pins
	&eth_rmii1_clk_pins>;

	phy-handle = <&rmii_phy1>;

	/* Vendor text; see gmac0 for what each slot does. */
	snps,reset-gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
	snps,reset-delays-us = <20000 20000 20000>;

	status = "okay";
};

&mdio1 {
	/* See mdio0. */
	compatible = "snps,dwmac-mdio";

	rmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
};

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	usb {
		vcc5v0_otg0_en: vcc5v0-otg0-en {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc5v0_otg1_en: vcc5v0-otg1-en {
			rockchip,pins = <1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
