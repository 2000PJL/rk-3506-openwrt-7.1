#include "rk3506.dtsi"

/ {
	model = "HZ-RK3506SP_MiniEVM";
	compatible = "rockchip,rk3506-evb1-v10", "rockchip,rk3506";

	/* PSCI is provided by the Rockchip OP-TEE secure monitor.
	 * Linux brings up secondary CPUs via PSCI SMC calls. */

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		i2c0 = &i2c0;
		i2c2 = &i2c2;
	};

	chosen {
		stdout-path = &uart0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* OP-TEE / trust resident memory.
		 * The SPL/loader pins OP-TEE in low DRAM [0x0, ~0x62000).
		 * Without this carve-out the kernel adds those pages to the
		 * free pool and hands them to user space; the secure world
		 * then rejects the access as a precise external abort.
		 * Mirrors the vendor rk3506 DT's trust@0 reservation. */
		trust@0 {
			/* OP-TEE reports 0x62000 bytes, but the secure DRAM firewall
			 * protects low memory at 4 MiB granularity on this board.
			 * Reserve 4 MiB to avoid handing secure pages to userspace. */
			reg = <0x0 0x400000>;
		};
	};

	vcc12v_dc: vcc12v-dc {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dc";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dc>;
	};

	vcc3v3_stb: vcc3v3-stb {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_stb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_stb>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vccio_sd: vccio-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vccio_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc5v0_otg0: vcc5v0-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg0_en>;
	};

	vcc5v0_otg1: vcc5v0-otg1-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg1";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg1_en>;
	};

	leds: leds {
		compatible = "gpio-leds";
		status = "okay";
		run_led: run-led {
			label = "run";
			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

};

/* CPU operating points (OPP).
 * Without an OPP table the cpufreq-dt driver has no valid frequency
 * targets; ondemand may attempt to scale the PVTPLL to an undefined
 * rate and hang the system.  These are conservative, clk-only points.
 * If a PMIC-based cpu-supply is added later, append voltage columns. */
&cpu0 {
	operating-points = <
		1200000	0	/* 1.2 GHz (stock boot speed) */
		1008000	0	/* 1.008 GHz */
		816000	0	/* 816 MHz */
		600000	0	/* 600 MHz */
		408000	0	/* 408 MHz */
	>;
};

&cpu1 {
	/* PSCI brings up cpu1 */
};

&cpu2 {
	/* PSCI brings up cpu2 */
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&uart3 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_i2c2_scl &rm_io5_i2c2_sda>;

	lt8912b: lt8912b@48 {
		compatible = "lontium,lt8912b-hdmi";
		reg = <0x48>;
		reset-gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&sai1 {
	status = "disabled";
};

&spi0 {
	status = "disabled";
	num-cs = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io14_spi0_clk &rm_io13_spi0_csn0 &rm_io15_spi0_csn1 &rm_io17_spi0_mosi &rm_io16_spi0_miso>;
	flash@0 {
		compatible = "winbond,w25q20cl", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
	flash@1 {
		compatible = "winbond,w25q20cl", "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <50000000>;
	};
};

&sfc {
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&u2phy_otg0 {
	status = "okay";
	/* VBUS supply controlled by GPIO PA2 (vcc5v0_otg0 regulator) */
	vbus-supply = <&vcc5v0_otg0>;
};

&u2phy_otg1 {
	status = "okay";
	/* VBUS supply controlled by GPIO PA1 (vcc5v0_otg1 regulator) */
	vbus-supply = <&vcc5v0_otg1>;
};

&usb20_otg0 {
	status = "okay";
	dr_mode = "host";
};

&usb20_otg1 {
	status = "okay";
	dr_mode = "host";
};

/* Sheet 03: the second port is a crystal-less YT8512H on the rmii0 pin group
 * (GPIO2 bank), fed its 25 MHz reference by ETH_CLK0_25M_OUT on GPIO0_C4 and
 * returning the 50 MHz RMII clock on RMII0_CLK, hence clock_in_out "input".
 *
 * Reset: RMII0_RSTN leaves ball L1 (REF_CLK1_OUT/SPI0_MISO/RM_IO18/GPIO0_C2_d)
 * and reaches PHYRSTB through a fitted R21 0R. Nothing else drives or pulls that
 * net -- sheet 03 has no resistor on RMII_RSTn, only R9 4.7K on PHY_INT -- so an
 * undriven pad leaves the PHY's reset input floating and the chip never starts.
 * That is why the previous build reported "MDIO device at address 3 is missing"
 * rather than a link or autonegotiation problem. Straight connection to an
 * RSTN-named pin, so ACTIVE_LOW: logical 1 (assert) drives the pad low.
 *
 * MDIO address: R4 and R226 (both 4.7K to VCC3V3_RMII) pull LED0/PHYAD0 and
 * LED1/PHYAD1, which would give PHYAD[1:0] = 2'b11 = address 3, but the same
 * sheet lists a "00(default)" strap row and R5/R7 are NC, so the address is a
 * guess. This build therefore drops phy-handle and lets stmmac scan the whole
 * bus and print what it actually finds. */
&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "input";

	/* Same clk_mac_refout trick as gmac1: the name puts CLK_MAC_OUT into
	 * dwmac-rk's RMII bulk clock list so the gate is enabled, and the
	 * assigned rate programs the PMU divider. clocks/clock-names replace the
	 * inherited four entries, so they are repeated here. */
	clocks = <&cru CLK_MAC0>, <&cru CLK_MAC0_PTP>,
		 <&cru PCLK_MAC0>, <&cru ACLK_MAC0>, <&cru CLK_MAC_OUT>;
	clock-names = "stmmaceth", "ptp_ref",
		      "pclk_mac", "aclk_mac", "clk_mac_refout";
	assigned-clocks = <&cru CLK_MAC0_PTP>, <&cru CLK_MAC_OUT>;
	assigned-clock-rates = <62500000>, <25000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
	&eth_rmii0_tx_bus2_pins
	&eth_rmii0_rx_bus2_pins
	&eth_rmii0_clk_pins
	&eth_clk0_25m_out_pins>;

	/* snps,reset-active-low is deliberately absent: stmmac_mdio_reset()
	 * never reads it, it takes the sense from the GPIO flag above through
	 * the gpiod logical-value API (set 1 = assert, wait delays[1], set 0 =
	 * release, wait delays[2]). The callback is installed at all because the
	 * legacy-MDIO path below sets needs_reset, and mdio_bus_provider runs
	 * bus->reset() before mdiobus_scan_bus_c22(). */
	snps,reset-gpio = <&gpio0 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <0 20000 100000>;

	/* DIAGNOSTIC: no phy-handle. Together with the missing
	 * "snps,dwmac-mdio" below this makes stmmac_platform take the
	 * legacy_mdio path; of_mdiobus_register(bus, NULL) then falls through to
	 * __mdiobus_register(), which probes every address 0..31 and lets
	 * phy_find_first() attach whatever answered. Restore phy-handle once the
	 * boot log has reported the real address. */
	status = "okay";
};

/* Kept as documentation of the guessed address only: with the
 * "snps,dwmac-mdio" compatible gone, stmmac_of_get_mdio() returns NULL and
 * nothing ever walks these children, and of_platform_populate() has no
 * compatible to match so no second platform device appears either (the -EBUSY
 * that patches-7.1/0021 removed the compatible to avoid). Do not put the
 * compatible back before the scan has named a real address, or the bus reverts
 * to probing only what is listed here. */
&mdio0 {
	rmii_phy0: phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
	};
};

/* Sheet 04: U3, a crystal-less YT8522H on the rmii1 pin group, fed its 25 MHz
 * reference by ETH_CLK1_25M_OUT on GPIO0_C3, so the 50 MHz RMII clock comes
 * back in.
 *
 * Reset: RMII1_RSTN/1.8V leaves ball G1 (OSC_CLK_OUT/REF_CLK0_OUT/GPIO0_D0_d).
 * The series R51 to PHY1RSTB is NC, but the earlier reading of that -- "reset is
 * formed locally by R63/Q1, so there is no snps,reset-gpio here" -- was wrong:
 * the net goes through R62 330R into the base of Q1 (MMBT3904, emitter to
 * ground), whose open collector pulls PHY1RSTB low through D2, while R63 4.7K
 * holds PHY1RSTB high when Q1 is off. That is an inverting stage, so asserting
 * reset means driving the pad HIGH -- GPIO_ACTIVE_HIGH, not ACTIVE_LOW, despite
 * the RSTN net name. The pull-up also means this PHY self-releases when the pin
 * is left floating, which is why stmmac-1 could fail for a different reason than
 * stmmac-0 did.
 *
 * MDIO address: read as 1 from the sheet-04 option table even though R35 and R37
 * both look fitted, so it is a guess and this build scans the whole bus. */
&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "input";

	/* The PHY is crystal-less (Y2/C24/C25 are NC) and takes its reference
	 * from ETH_CLK1_25M_OUT, so clk_mac_out has to run at 25 MHz and reach
	 * that pad. Naming the clock clk_mac_refout is what puts it in
	 * dwmac-rk's RMII bulk list, which prepares and enables the gate; the
	 * rate reaches PMU_CLKSEL_CON0[15:10] through the clock core when this
	 * node probes. clocks/clock-names are replaced whole, so the four
	 * inherited entries are repeated here. */
	clocks = <&cru CLK_MAC1>, <&cru CLK_MAC1_PTP>,
		 <&cru PCLK_MAC1>, <&cru ACLK_MAC1>, <&cru CLK_MAC_OUT>;
	clock-names = "stmmaceth", "ptp_ref",
		      "pclk_mac", "aclk_mac", "clk_mac_refout";
	assigned-clocks = <&cru CLK_MAC1_PTP>, <&cru CLK_MAC_OUT>;
	assigned-clock-rates = <62500000>, <25000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins
	&eth_rmii1_tx_bus2_pins
	&eth_rmii1_rx_bus2_pins
	&eth_rmii1_clk_pins
	&eth_clk1_25m_out_pins>;

	/* Polarity per the block comment above; see gmac0 for why
	 * snps,reset-active-low is absent. */
	snps,reset-gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
	snps,reset-delays-us = <0 20000 100000>;

	/* DIAGNOSTIC: see gmac0 -- no phy-handle plus no mdio compatible below
	 * gives the legacy full 0..31 scan. */
	status = "okay";
};

/* Adding "snps,dwmac-mdio" here (commit 7479dfc) was what made stmmac register
 * an MDIO bus at all: rk3506.dtsi's mdio1 carries no compatible, so
 * stmmac_of_get_mdio() returned NULL, the bus never appeared in the device list,
 * and the attach failed with -ENODEV. The boot log now confirms that on real
 * silicon -- mdio_bus stmmac-0 and stmmac-1 are both added. The compatible is
 * taken back out only so this diagnostic build scans every address rather than
 * the one guessed here; the child node is documentation, nothing walks it. */
&mdio1 {
	rmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&pinctrl {
	/* GPIO0_C3 and GPIO0_C4 double as ETH_CLK1_25M_OUT and
	 * ETH_CLK0_25M_OUT (sheet 02 pin table; the nets go to the PHYs on
	 * sheets 03 and 04). The function index comes from the order of the
	 * alternate names on those balls, not from the TRM, so treat 1 as the
	 * working assumption to be confirmed on hardware. */
	eth {
		eth_clk1_25m_out_pins: eth-clk1-25m-out-pins {
			rockchip,pins = <0 RK_PC3 1 &pcfg_pull_none>;
		};
		eth_clk0_25m_out_pins: eth-clk0-25m-out-pins {
			rockchip,pins = <0 RK_PC4 1 &pcfg_pull_none>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	usb {
		vcc5v0_otg0_en: vcc5v0-otg0-en {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc5v0_otg1_en: vcc5v0-otg1-en {
			rockchip,pins = <1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
